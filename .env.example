# ====================================================================
# 🌟 GOOGLE AI STUDIO CONFIGURATION
# ====================================================================
# 
# LangChain's ChatGoogleGenerativeAI natively detects either GEMINI_API_KEY or GOOGLE_API_KEY. We suggest providing GEMINI_API_KEY.
GEMINI_API_KEY=your_google_ai_studio_api_key_here

# The active model we'll use when only one model is configured (backward compatible)
GEMINI_MODEL=gemini-2.5-flash

# Multi-model support (optional): comma-separated provider-prefixed refs.
# Auto-routing:
#   orchestration, navigation → strongest model (pro/flash/composer)
#   extraction, self_heal     → fastest model (flash-lite)
# Failover tries the next model on 503 / timeout.
#
# Examples:
# LLM_MODELS=google:gemini-3.1-flash-lite,google:gemini-3.5-flash
# LLM_MODELS=google:gemini-3.1-flash-lite,google:gemini-3.5-flash,cursor:composer-2.5
#
# When LLM_MODELS is unset, GEMINI_MODEL is used for all tasks.
# LLM_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash

# Optional explicit task→model routing (JSON). Overrides auto-selection.
# Use the same refs as in LLM_MODELS (provider:model_id).
# LLM_TASK_ROUTING={"orchestration":"cursor:composer-2.5","navigation":"cursor:composer-2.5","extraction":"google:gemini-3.1-flash-lite","self_heal":"google:gemini-3.1-flash-lite"}

# ====================================================================
# 🤖 CURSOR AI (optional — native cursor-sdk, no proxy)
# ====================================================================
# Cursor models are NOT Google Gemini. They use the Cursor SDK directly.
# Wired for orchestration + navigation only (extraction/self_heal stay on Gemini).
#
# 1. Get CURSOR_API_KEY from Cursor Dashboard → Integrations
# 2. Add cursor:composer-2.5 (or cursor:gpt-5.5) to LLM_MODELS
#
# Runtime:
#   CURSOR_RUNTIME=local   — runs via SDK against CURSOR_WORKDIR (default: repo root)
#   CURSOR_RUNTIME=cloud   — requires CURSOR_CLOUD_REPO (Git URL for Cloud Agent VM)
#
# CURSOR_API_KEY=crsr_your_key_here
# CURSOR_RUNTIME=local
# CURSOR_WORKDIR=/path/to/NFE_Agent
# CURSOR_CLOUD_REPO=https://github.com/your-org/NFE_Agent
# CURSOR_DEFAULT_MODEL=composer-2.5

# LLM call safeguards
# Reasoning tasks (orchestration, navigation) use LLM_TIMEOUT_REASONING when set.
LLM_TIMEOUT_SECONDS=60
LLM_TIMEOUT_REASONING=120
LLM_MAX_RETRIES=1

# If langgraph dev still raises BlockingError on socket.connect, restart with:
#   langgraph dev --allow-blocking
# (Gemini's client uses sync HTTP; the app also sets blockbuster_skip around LLM calls.)

# Pull navigator prompts from LangSmith Hub (off by default — sync pulls block the event loop)
# USE_LANGSMITH_PROMPTS=false
# ====================================================================
# 🛠 LANGSMITH MONITORING CONFIGURATION
# ====================================================================
# Off by default — enabling exports prompts/traces (may include journey text).
# Only turn on after reviewing docs/security/security.md (credentials use placeholders).
LANGCHAIN_TRACING_V2=false

# Your LangSmith API endpoint (defaults to the cloud-hosted version)
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"

# Paste your LangSmith API key here
LANGCHAIN_API_KEY=lsv2_pt_your_langsmith_key_here

# Define the project workspace where your agent traces will be grouped
LANGCHAIN_PROJECT="gemini-agent-learning"

# ====================================================================
# 🔒 SECURITY POLICY (see docs/security/security.md)
# ====================================================================
# NFE_URL_ALLOWLIST=opensource-demo.orangehrmlive.com,httpbin.org
# NFE_URL_DENY_PRIVATE=true
# NFE_ALLOW_LOCALHOST=false
# NFE_STORE_CREDENTIALS=true
# Keep username/password from Watch-Me in recordings + IR + k6 scripts (per app).
# Set false only if you must wipe secrets from disk (then scripts need another source).
# NFE_REDACT_ARTIFACTS=true
# Still masks cookies/auth headers in network captures; password fills kept when STORE=true.
# Jira/Confluence comments still redact password-looking text.

# ====================================================================
# 🎫 JIRA CLOUD (chat-driven — see docs/workers/jira-integration.md)
# ====================================================================
# Prefer an API token WITHOUT scopes (classic) for site URL + Basic auth.
# If using classic scopes: read:jira-user, read:jira-work, write:jira-work.
# Granular scoped tokens need api.atlassian.com/ex/jira/{cloudId} (not default).
# JIRA_BASE_URL=https://your-site.atlassian.net
# JIRA_EMAIL=bot@example.com
# JIRA_API_TOKEN=
# NFE_JIRA_LABEL=nfe-agent
# Comma-separated issue types eligible for pickup (empty or * = any type)
# NFE_JIRA_ISSUE_TYPES=Story,Task,Bug,Issue
# Board statuses eligible for pickup
# NFE_JIRA_STATUSES=To Do,In Progress
# NFE_JIRA_IN_PROGRESS_STATUS=In Progress
# Optional full JQL override (when set, ignores auto-built label/type/status JQL)
# NFE_JIRA_POLL_JQL=
# Optional: Acceptance Criteria custom field id (auto-discovered by name if empty)
# NFE_JIRA_ACCEPTANCE_FIELD=customfield_10043

# ====================================================================
# 📄 CONFLUENCE CLOUD (publish completed runs — see docs/workers/confluence-publishing.md)
# ====================================================================
# Basic auth: CONFLUENCE_EMAIL + CONFLUENCE_API_TOKEN (same pattern as Jira).
# Empty BASE/EMAIL/TOKEN → fall back to JIRA_*.
# Publish when summary.json proves the run completed (SLA pass/fail/watcher-stop).
# Mid-run infra aborts (timeout/spawn, no summary) skip Confluence.
# CONFLUENCE_BASE_URL=https://your-site.atlassian.net
# CONFLUENCE_EMAIL=bot@example.com
# CONFLUENCE_API_TOKEN=
# CONFLUENCE_SPACE_KEY=ENG
# CONFLUENCE_PARENT_TITLE=Performance Testing and Engineering
# NFE_CONFLUENCE_PUBLISH=true

# k6 threshold watcher (abortOnFail) — see docs/pipeline/smoke-and-self-heal.md
# Abort mid-run only on *catastrophic* breaches; tight SLA still fails the test at end.
# NFE_K6_ABORT_ON_FAIL=true
# NFE_K6_ABORT_DELAY=10s
# Stop when ≥60% of HTTP requests have failed
# NFE_K6_ABORT_FAIL_RATE=0.60
# Stop when p99 latency exceeds 30s (0 = disable)
# NFE_K6_ABORT_P99_MS=30000
# Stop when checks pass-rate falls below 40% (0 = disable)
# NFE_K6_ABORT_CHECKS_MIN=0.40
# Also abort on tight SLA (1% errors / p95) — usually leave false
# NFE_K6_SLA_ABORT_ON_FAIL=false

# ====================================================================
# 📈 DYNATRACE / OPENTELEMETRY CONFIGURATION
# ====================================================================
# Dynatrace / OpenLLMetry OTLP endpoint (traces + correlated logs)
# Example: https://<env-id>.live.dynatrace.com/api/v2/otlp
TRACELOOP_BASE_URL=
# Dynatrace authorization headers (token needs openTelemetryTrace.ingest + logs.ingest scopes)
# Example: Authorization=Api-Token%20<your-token>
TRACELOOP_HEADERS=

# Alternative OpenTelemetry exporter configuration (falls back when TRACELOOP_* is unset)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# Set to false to disable the legacy /api/v2/logs/ingest handler (OTLP logs remain enabled)
DYNATRACE_LOG_INGEST_ENABLED=true

# ====================================================================
# 🔌 PROJECT MCP SERVERS
# ====================================================================
# Single registry file for all MCP servers used by this LangGraph app.
# Default: config/mcp_servers.json  (edit that file to enable servers)
# MCP_SERVERS_CONFIG=

# Where generated k6 scripts / IR JSON are written for download
# NFE_ARTIFACTS_DIR=

# ====================================================================
# 📂 APP-SCOPED ARTIFACTS + LOCAL RAG (ChromaDB)
# ====================================================================
# App id = URL domain (netloc). See docs/pipeline/app-artifacts-and-knowledge.md
# Fallback only when no target URL exists yet (rare bootstrap).
# NFE_DEFAULT_APP=opensource-demo.orangehrmlive.com
# NFE_RAG_ENABLED=true
# NFE_RAG_TOP_K=4