# === LLM (Cursor only) ===
CURSOR_API_KEY=crsr_your_key_here
CURSOR_DEFAULT_MODEL=composer-2.5
CURSOR_RUNTIME=local
# CURSOR_WORKDIR=/path/to/NFE_Agent
# CURSOR_CLOUD_REPO=https://github.com/your-org/NFE_Agent
# Optional override list: LLM_MODELS=cursor:composer-2.5

# === LangSmith ===
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_pt_your_langsmith_api_key_here
LANGSMITH_PROJECT=PE-Agent
# LANGSMITH_ENDPOINT=https://apac.api.smith.langchain.com

# === Jira (optional) ===
# JIRA_BASE_URL=https://your-site.atlassian.net
# JIRA_EMAIL=you@example.com
# JIRA_API_TOKEN=
# NFE_JIRA_LABEL=nfe-agent

# === Confluence (optional) ===
# CONFLUENCE_BASE_URL=
# CONFLUENCE_EMAIL=
# CONFLUENCE_API_TOKEN=
# CONFLUENCE_SPACE_KEY=SD
# NFE_CONFLUENCE_PUBLISH=true

# === App ===
NFE_ARTIFACTS_DIR=artifacts
NFE_STORE_CREDENTIALS=true
NFE_RAG_ENABLED=true
NFE_PE_AGENT_ENABLED=true
